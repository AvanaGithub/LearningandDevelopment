# ---- Learning Hub server environment ----
# Copy to `.env` and fill in. NEVER commit the real .env.

PORT=3200
NODE_ENV=development
# Public origin the app is served from (used for the Zoho redirect URI).
BASE_URL=http://localhost:3200

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/academy

# ---- Zoho OAuth (Server-based Application from api-console.zoho.in) ----
# The registered Authorized Redirect URI must be exactly:
#   <BASE_URL>/auth/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in

# Dev-only e-mail login with no password (POST /api/auth/dev-login).
# ALWAYS false in production.
DEV_LOGIN=false

# First super admin, created by `npm run seed` if the users table is empty.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
